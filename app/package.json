{
  "name": "onirique-central",
  "productName": "ONIRIQUE CENTRAL",
  "version": "1.0.43",
  "private": true,
  "description": "Installez, mettez à jour et activez les plugins ONIRIQUE.",
  "author": "Onirique",
  "main": "main/main.js",
  "scripts": {
    "sync-player": "node -e \"require('fs').copyFileSync('../site/assets/demo-player.js', 'renderer/demo-player.js')\"",
    "prestart": "npm run sync-player",
    "start": "electron .",
    "predist": "npm run sync-player",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.onirique.central",
    "productName": "ONIRIQUE CENTRAL",
    "files": [
      "main/**",
      "renderer/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis",
      "extraResources": [
        {
          "from": "../tools/probe/build/OniriqueProbe_artefacts/Release/OniriqueProbe.exe",
          "to": "onirique-probe.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ONIRIQUE CENTRAL",
      "artifactName": "ONIRIQUE-CENTRAL-Setup-${version}.${ext}",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "multiLanguageInstaller": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://onirique.store/telechargement/"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": "dir",
      "identity": null
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
