#!/usr/bin/env bash
# Règle « Se connecter avec Pinterest » (images des vidéos de prods, ONIRIQUE CLOUD). À lancer sur le VPS, en root :
#   onirique-pinterest        demande l'App ID et la clé secrète de l'application Pinterest
#   onirique-pinterest off    retire le réglage (les comptes reliés ne s'affichent plus)
# Le secret est saisi ici, sans s'afficher, et ne quitte pas le serveur.
#
# À faire avant, sur developers.pinterest.com :
#   1. My apps > Connect app : nom, description, site https://onirique.store ; demander l'accès (Trial access).
#   2. Dans l'application : Redirect URIs, ajouter l'adresse affichée ci-dessous.
#   3. Copier l'App ID et l'App secret key.
# Tant que l'accès d'essai n'est pas accordé par Pinterest, seul le compte qui a créé l'application peut se connecter.
set -euo pipefail

ENVFILE=/opt/onirique-central/server/.env
stop() { echo "$1" >&2; exit 1; }

if [ "${1:-}" != off ]; then
  PUBLIC=$(grep -E '^PUBLIC_URL=' "$ENVFILE" | cut -d= -f2- | tr -d "'\"" | sed 's:/*$::')
  [ -n "$PUBLIC" ] || stop "PUBLIC_URL manque dans $ENVFILE."
  echo "Adresse de retour (Redirect URI) à déclarer chez Pinterest : $PUBLIC/api/pinterest/callback"
  read -rp "App ID : " ID
  read -rsp "App secret key (rien ne s'affiche) : " SECRET; echo
  # Un collage dans le terminal ajoute parfois des caractères invisibles : seuls ceux d'un identifiant sont gardés.
  ID=$(printf '%s' "$ID" | sed 's/\x1b\[20[01]~//g' | tr -cd 'A-Za-z0-9_-')
  SECRET=$(printf '%s' "$SECRET" | sed 's/\x1b\[20[01]~//g' | tr -cd 'A-Za-z0-9_-')
  case "$ID" in ''|*[!0-9]*) stop "L'App ID de Pinterest est un nombre. Rien n'est changé." ;; esac
  [ -n "$SECRET" ] || stop "Clé secrète vide. Rien n'est changé."
fi

sed -i '/^PINTEREST_APP_ID=/d; /^PINTEREST_APP_SECRET=/d' "$ENVFILE"
[ "${1:-}" = off ] || printf "PINTEREST_APP_ID='%s'\nPINTEREST_APP_SECRET='%s'\n" "$ID" "$SECRET" >> "$ENVFILE"
chown central:central "$ENVFILE"; chmod 600 "$ENVFILE"
systemctl restart onirique-central
sleep 3
systemctl is-active -q onirique-central || stop "Le serveur n'a pas redémarré : journalctl -u onirique-central"
if [ "${1:-}" = off ]; then echo "« Se connecter avec Pinterest » retiré."; else echo "C'est bon : « Se connecter avec Pinterest » apparaît dans le choix des images des vidéos de prods."; fi
