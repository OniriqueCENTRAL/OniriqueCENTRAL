#!/usr/bin/env bash
# Branche les chiffres Spotify des pages de profil et de la carte (CaptAPI). À lancer sur le VPS, en root :
#   onirique-captapi        demande la clé CaptAPI
#   onirique-captapi off    retire la clé (les chiffres déjà lus restent, ils ne sont plus mis à jour)
#
# À faire avant, sur captapi.com : créer un compte ; le tableau de bord donne la clé (capt_live_…).
set -euo pipefail

ENVFILE=/opt/onirique-central/server/.env
stop() { echo "$1" >&2; exit 1; }

if [ "${1:-}" != off ]; then
  KEY=''
  while :; do
    read -r -s -p "Clé CaptAPI (rien ne s'affiche) : " KEY; echo >&2
    KEY=${KEY//[[:space:]]/}
    [[ $KEY =~ ^[A-Za-z0-9_-]{16,}$ ]] && break
    [ -z "$KEY" ] || echo "Ça ne ressemble pas à une clé CaptAPI, recolle-la." >&2
  done
  # La clé est essayée avant d'être gardée (réponse en cache chez CaptAPI : en général gratuite).
  code=$(curl -s -o /dev/null -w '%{http_code}' -H "x-api-key: $KEY" \
    "https://api.captapi.com/v1/spotify/artist?url=spotify%3Aartist%3A06HL4z0CvFAxyc27GXpf02&cache=true")
  [ "$code" = 200 ] || stop "CaptAPI refuse cette clé (réponse $code) : vérifie-la sur captapi.com."
fi

sed -i '/^CAPTAPI_KEY=/d' "$ENVFILE"
[ "${1:-}" = off ] || printf "CAPTAPI_KEY='%s'\n" "$KEY" >> "$ENVFILE"
chown central:central "$ENVFILE"; chmod 600 "$ENVFILE"
systemctl restart onirique-central
sleep 3
systemctl is-active -q onirique-central || stop "Le serveur n'a pas redémarré : journalctl -u onirique-central"
if [ "${1:-}" = off ]; then echo "Chiffres Spotify débranchés."; else echo "C'est bon : colle le lien de ton profil d'artiste Spotify dans « Modifier ma page »."; fi
