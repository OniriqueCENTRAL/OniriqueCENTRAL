#!/usr/bin/env bash
# Règle les réponses automatiques Instagram de la page compte. À lancer sur le VPS, en root :
#   onirique-social        demande l'ID et la clé secrète de l'application Meta
#   onirique-social off    retire le réglage (les automations ne répondent plus)
# Le secret est saisi ici, sans s'afficher, et ne quitte pas le serveur.
#
# À faire avant sur developers.facebook.com :
#   1. Créer une application (type « Entreprise »), puis ajouter le produit « Instagram » > « API setup with Instagram login ».
#   2. Y relever l'« Instagram app ID » et l'« Instagram app secret » (pas ceux de l'application Facebook).
#   3. « Business login settings » : URL de redirection OAuth = celle affichée ci-dessous.
#   4. Webhooks : URL de rappel et jeton de vérification affichés ci-dessous, puis s'abonner au champ « comments ».
#   5. Rôles de l'application : ajouter votre compte Instagram comme testeur et accepter l'invitation dans l'appli
#      Instagram (Paramètres > Applications et sites web). En mode développement, cela suffit pour votre propre compte.
#   6. Dans l'appli Instagram : Paramètres > Messages > Outils connectés > « Autoriser l'accès aux messages » (pour les DM).
# Le compte relié doit être un compte professionnel ou créateur.
set -euo pipefail

ENVFILE=/opt/onirique-central/server/.env
stop() { echo "$1" >&2; exit 1; }

if [ "${1:-}" != off ]; then
  PUBLIC=$(grep -E '^PUBLIC_URL=' "$ENVFILE" | cut -d= -f2- | tr -d "'\"" | sed 's:/*$::')
  [ -n "$PUBLIC" ] || stop "PUBLIC_URL manque dans $ENVFILE."
  VERIFY=$(grep -E '^INSTAGRAM_VERIFY_TOKEN=' "$ENVFILE" | cut -d= -f2- | tr -d "'\"" || true)
  [ -n "$VERIFY" ] || VERIFY=$(openssl rand -hex 20)
  echo "URL de redirection OAuth : $PUBLIC/api/social/instagram/callback"
  echo "Webhook, URL de rappel   : $PUBLIC/api/social/instagram/webhook"
  echo "Webhook, jeton           : $VERIFY"
  read -rp "Instagram app ID : " ID
  read -rsp "Instagram app secret (rien ne s'affiche) : " SECRET; echo
  case "$ID" in *[!0-9]*|'') stop "Un ID d'application Instagram n'a que des chiffres. Rien n'est changé." ;; esac
  case "$SECRET" in *"'"*|*" "*) stop "Secret mal copié (espace ou apostrophe). Rien n'est changé." ;; esac
  [ -n "$SECRET" ] || stop "Secret vide. Rien n'est changé."
fi

sed -i '/^INSTAGRAM_APP_ID=/d; /^INSTAGRAM_APP_SECRET=/d; /^INSTAGRAM_VERIFY_TOKEN=/d' "$ENVFILE"
[ "${1:-}" = off ] || printf "INSTAGRAM_APP_ID='%s'\nINSTAGRAM_APP_SECRET='%s'\nINSTAGRAM_VERIFY_TOKEN='%s'\n" "$ID" "$SECRET" "$VERIFY" >> "$ENVFILE"
chown central:central "$ENVFILE"; chmod 600 "$ENVFILE"
systemctl restart onirique-central
sleep 3
systemctl is-active -q onirique-central || stop "Le serveur n'a pas redémarré : journalctl -u onirique-central"
if [ "${1:-}" = off ]; then echo "Connexion à Instagram retirée."; else echo "C'est bon : le bouton « Relier Instagram » de la page compte est actif."; fi
