#!/usr/bin/env bash
# Ouvre ou ferme la vente en ligne par Stripe, en « Managed Payments » : Stripe est le vendeur officiel, il
# facture les clients, gère la TVA et les litiges, et reverse le reste.
# À lancer sur le VPS, en root :
#   onirique-stripe        ne demande que la clé secrète ; le reste est essayé ou créé chez Stripe
#   onirique-stripe off    ferme la vente (les réglages restent en place pour la rouvrir)
# La clé est saisie ici, sans s'afficher, et ne quitte pas le serveur.
#
# À faire avant, dans le tableau de bord Stripe :
#   1. Activer le compte (identité, compte bancaire).
#   2. Paramètres > Managed Payments : accepter les conditions. Stripe décide de l'accès après examen.
#   3. Développeurs > Clés API : copier la clé secrète (sk_live_…). Une clé sk_test_… n'encaisse rien :
#      c'est le bon réglage pour un premier essai, à refermer ensuite.
set -euo pipefail

APP=/opt/onirique-central/server
ENVFILE=$APP/.env
stop() { echo "$1" >&2; exit 1; }
mode() { curl -fsS "http://127.0.0.1:$(grep -E '^PORT=' "$ENVFILE" | cut -d= -f2)/api/catalog" | grep -o '"paymentsMode":"[a-z]*"' || true; }

if [ "${1:-}" = off ]; then
  sed -i 's/^PAYMENTS_MODE=.*/PAYMENTS_MODE=off/' "$ENVFILE"
  systemctl restart onirique-central
  sleep 2
  echo "Vente fermée. État annoncé par le serveur : $(mode)"
  exit 0
fi

PUBLIC=$(grep -E '^PUBLIC_URL=' "$ENVFILE" | cut -d= -f2- | tr -d "'\"" | sed 's:/*$::')
[ -n "$PUBLIC" ] || stop "PUBLIC_URL manque dans $ENVFILE."
read -rsp "Clé secrète Stripe (sk_live_… ou sk_test_… ; rien ne s'affiche) : " KEY; echo
case "$KEY" in sk_live_*|sk_test_*|rk_live_*|rk_test_*) ;; *) stop "Ce n'est pas une clé secrète Stripe (elle commence par sk_live_ ou sk_test_). Rien n'est changé." ;; esac
case "$KEY" in *"'"*|*" "*) stop "Clé mal copiée (espace ou apostrophe). Rien n'est changé." ;; esac
if [ "${KEY#??_test_}" != "$KEY" ]; then
  echo "Clé d'ESSAI : rien ne sera encaissé, et n'importe qui pourra « acheter » avec la carte de test 4242… et recevoir une vraie licence."
  read -rp "Pour ouvrir quand même le temps d'un essai, tapez essai : " SURE
  [ "$SURE" = essai ] || stop "Rien n'est changé."
fi

# Tout le dialogue avec Stripe : pages de paiement d'essai faites comme celles du site, puis le webhook.
# Sa sortie normale est le secret du webhook ; ses messages passent par la sortie d'erreur.
HOOK=$(KEY="$KEY" HOOK_URL="$PUBLIC/api/stripe/webhook" node --input-type=module - <<'NODE'
const { KEY, HOOK_URL } = process.env;
const say = (text) => console.error(text);
const flatten = (object, prefix = '', out = new URLSearchParams()) => {
  for (const [key, value] of Object.entries(object)) {
    const name = prefix ? `${prefix}[${key}]` : key;
    if (value !== null && typeof value === 'object') flatten(value, name, out);
    else if (value !== undefined) out.append(name, String(value));
  }
  return out;
};
const api = async (method, path, body) => {
  const response = await fetch('https://api.stripe.com/v1' + path, {
    method,
    headers: { Authorization: 'Bearer ' + KEY, 'Content-Type': 'application/x-www-form-urlencoded', 'Stripe-Version': '2025-03-31.basil' },
    body: body ? flatten(body) : undefined,
  });
  const json = await response.json();
  if (!response.ok) throw new Error(json.error?.message || 'réponse ' + response.status);
  return json;
};

try {
  const account = await api('GET', '/account');
  say(`Compte : ${account.settings?.dashboard?.display_name || account.business_profile?.name || account.email || account.id} (${account.country})`);
  if (KEY.includes('_live_') && !account.charges_enabled) throw new Error("ce compte ne peut pas encore encaisser : terminez son activation dans le tableau de bord");

  // Une page de paiement de chaque sorte, à 1 €, annulée aussitôt : Stripe dit ici si Managed Payments est ouvert au compte.
  for (const [label, mode, recurring, tax_code] of [['Achat définitif', 'payment', undefined, 'txcd_10202000'], ['Abonnement', 'subscription', { interval: 'month' }, 'txcd_10103100']]) {
    const session = await api('POST', '/checkout/sessions', {
      mode, locale: 'fr', success_url: 'https://onirique.store', managed_payments: { enabled: true },
      line_items: [{ quantity: 1, price_data: { currency: 'eur', unit_amount: 100, recurring, tax_behavior: 'inclusive',
        product_data: { name: 'Essai de réglage ONIRIQUE', tax_code } } }],
    });
    await api('POST', `/checkout/sessions/${session.id}/expire`).catch(() => {});
    say(`${label} : page de paiement acceptée par Stripe.`);
  }

  // Le webhook prévient ce serveur de chaque paiement : c'est lui qui crée les licences. L'ancien est remplacé.
  for (const hook of (await api('GET', '/webhook_endpoints?limit=100')).data) {
    if (hook.url === HOOK_URL) await api('DELETE', '/webhook_endpoints/' + hook.id);
  }
  const hook = await api('POST', '/webhook_endpoints', { url: HOOK_URL, api_version: '2025-03-31.basil',
    enabled_events: ['checkout.session.completed', 'checkout.session.async_payment_succeeded', 'charge.refunded',
      'customer.subscription.created', 'customer.subscription.updated', 'customer.subscription.deleted'] });
  say(`Webhook : créé vers ${HOOK_URL}`);
  console.log(hook.secret);
} catch (error) {
  say(`Stripe refuse : ${error.message}`);
  say("Rien n'est changé. Si le message parle de « managed payments », activez-le dans Paramètres > Managed Payments du tableau de bord Stripe.");
  process.exit(1);
}
NODE
) || exit 1
case "$HOOK" in whsec_*) ;; *) stop "Stripe n'a pas rendu le secret du webhook. Rien n'est changé." ;; esac

cp "$ENVFILE" "$ENVFILE.avant-stripe"
sed -i '/^PAYMENTS_MODE=/d; /^STRIPE_SECRET_KEY=/d; /^STRIPE_WEBHOOK_SECRET=/d; /^STRIPE_MANAGED=/d' "$ENVFILE"
printf "PAYMENTS_MODE=stripe\nSTRIPE_MANAGED=1\nSTRIPE_SECRET_KEY='%s'\nSTRIPE_WEBHOOK_SECRET='%s'\n" "$KEY" "$HOOK" >> "$ENVFILE"
chown central:central "$ENVFILE"; chmod 600 "$ENVFILE"
systemctl restart onirique-central
sleep 3
if systemctl is-active -q onirique-central && [ "$(mode)" = '"paymentsMode":"stripe"' ]; then
  rm -f "$ENVFILE.avant-stripe"
  echo "C'est bon : la vente est ouverte. Faites un achat d'essai sur le site, puis vérifiez que la licence arrive sur le compte."
  echo "Pour refermer : onirique-stripe off"
else
  mv "$ENVFILE.avant-stripe" "$ENVFILE"
  systemctl restart onirique-central
  stop "Le serveur n'a pas redémarré avec ces réglages : l'ancien réglage est remis, la vente reste fermée."
fi
