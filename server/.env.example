# Copier ce fichier en ".env" puis adapter.

PORT=4850
# Adresse publique du serveur (utilisée pour les retours de paiement Stripe).
PUBLIC_URL=http://localhost:4850
# Dossier des données : base SQLite, clés de signature, fichiers des plugins.
DATA_DIR=./data

# Adresse du site qui porte la page compte (lien « mot de passe oublié »). Par défaut : PUBLIC_URL.
SITE_URL=
# Envoi des e-mails (validation de l'adresse à l'inscription, mot de passe oublié, support). Sans SMTP, le lien est envoyé au webhook Discord du support.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Compte administrateur créé par "npm run seed" s'il n'existe pas encore.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi

# Paiements : "demo" (achat accordé sans paiement, pour tester), "stripe" ou "off".
# Ne jamais laisser "demo" sur un serveur ouvert au public.
PAYMENTS_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
